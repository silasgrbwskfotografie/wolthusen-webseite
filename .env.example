# Kopieren nach .env und ausfüllen:  cp .env.example .env

# Adresse von Webseite (/) und Hub (/hub). Das ist der EINZIGE Wert, der beim Wechsel auf eine Domain geändert wird.
# Ohne Domain: die IP des Servers, z. B. DOMAIN=203.0.113.10 (HTTPS mit eigenem Zertifikat, Browser warnt einmal).
# Mit Domain: z. B. DOMAIN=amisia-stern.de (DNS-A-Eintrag auf die Server-IP, Caddy holt Let's Encrypt selbst).
DOMAIN=hub.example.de

# Weitere Adressen, die dauerhaft auf DOMAIN umleiten (optional, mehrere mit Leerzeichen trennen, ohne Anführungszeichen), z. B.:
# REDIRECT_DOMAINS=www.amisia-stern.de
# Jede davon braucht ebenfalls einen DNS-Eintrag auf die Server-IP. Ohne Domain (nur IP) die Zeile auskommentiert lassen.

# E-Mail für das Let's-Encrypt-Zertifikat (Hinweise bei Ablauf o. Ä.)
ACME_EMAIL=info@example.de

# Erster Admin-Zugang (wird nur angelegt, solange es noch keinen Benutzer gibt)
TMH_ADMIN_USER=silas
TMH_ADMIN_PASSWORD=bitte-ein-langes-passwort-eintragen

# Auf 1 setzen, um das Passwort von TMH_ADMIN_USER beim nächsten Start zurückzusetzen
# (danach wieder auf 0 stellen)
TMH_RESET_PASSWORD=0

# Wie viele tägliche Sicherungen aufbewahrt werden
TMH_BACKUP_KEEP=14
