# Zentraler Proxy (/opt/docker/proxy/.env). Kopieren nach .env und ausfüllen.

# E-Mail für Let's Encrypt (Hinweise zu Zertifikaten)
ACME_EMAIL=info@example.de

# app1: Wolthusen Hub
HUB_DOMAIN=example.de
# Weitere Adressen, die auf HUB_DOMAIN umleiten (mehrere mit Leerzeichen). Ohne Umleitung die Zeile auskommentieren, nie leer lassen.
HUB_REDIRECTS=www.example.de

# app2: später ergänzen und den Block im Caddyfile einkommentieren
# APP2_DOMAIN=app2.example.de
